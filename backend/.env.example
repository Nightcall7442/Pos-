# Server
PORT=3000
NODE_ENV=development

# Database: PostgreSQL 16. Locally: `docker compose up -d --wait postgres`
# (see docker-compose.yml), or any Postgres 16 with a UTF-8 locale.
#  - connection_limit / pool_timeout: размер пула соединений Prisma;
#  - options=-c TimeZone=UTC: Prisma хранит время в UTC, и значения по
#    умолчанию из базы должны считаться в том же поясе.
DATABASE_URL="postgresql://qwik:qwik@localhost:5432/qwik?schema=public&connection_limit=10&pool_timeout=20&options=-c%20TimeZone%3DUTC"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN="http://localhost:5173"

# Orders
# Unpaid orders hold a stock reservation; cancelled automatically after this long
PENDING_ORDER_TTL_MINUTES=30

# Logging
LOG_LEVEL="info"

# Barcode catalogue: codes the shipped snapshot does not know are looked up live
# on Open Food Facts (and its sister catalogues). "off" turns the network lookup
# off; OFF_BASE_URL sends it to one server instead (tests use a stub).
# CATALOG_LIVE_LOOKUP="on"
# OFF_BASE_URL=""
