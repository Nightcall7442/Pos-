generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  // "cafe" — зал, столы, навынос; "retail" — магазин: сканер, вес, чек без столов.
  businessType         String    @default("cafe") @map("business_type")
  logoUrl              String?   @map("logo_url")
  phone                String?
  email                String?
  address              String?
  timezone             String    @default("UTC")
  currency             String    @default("USD")
  taxRate              Float     @default(0) @map("tax_rate")
  defaultMarkupPercent Float     @default(0) @map("default_markup_percent")
  subscriptionPlan     String    @default("free") @map("subscription_plan")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  settings             String    @default("{}")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  users        User[]
  branches     Branch[]
  categories   Category[]
  products     Product[]
  orders       Order[]
  payments     Payment[]
  inventory    InventoryMovement[]
  tables       Table[]
  reservations Reservation[]
  receipts     Receipt[]
  stockReceipts StockReceipt[]
  cashShifts   CashShift[]
  auditLogs    AuditLog[]
  notifications Notification[]
  techCards    TechCard[]

  @@map("tenants")
}

model User {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  pin           String?
  role          String    @default("cashier")
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  orders         Order[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  inventory      InventoryMovement[]
  stockReceipts  StockReceipt[]
  cashShifts     CashShift[]

  @@unique([tenantId, email])
  @@map("users")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  settings  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders      Order[]
  tables      Table[]
  reservations Reservation[]

  @@map("branches")
}

model Category {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  name        String
  description String?
  imageUrl    String?    @map("image_url")
  color       String?
  sortOrder    Int        @default(0) @map("sort_order")
  isIngredient Boolean    @default(false) @map("is_ingredient")
  markupPercent Float     @default(0) @map("markup_percent")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model TechCard {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  ingredients String   @default("[]")
  totalCost   Float    @default(0) @map("total_cost")
  output      Float    @default(0)
  unit        String   @default("г")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("tech_cards")
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String?  @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  techCardId    String?  @map("tech_card_id")
  techCardRef   TechCard? @relation(fields: [techCardId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  volume        String?
  sku           String?
  barcode       String?
  imageUrl      String?  @map("image_url")
  price         Float    @default(0)
  costPrice     Float    @default(0) @map("cost_price")
  compareAtPrice Float?  @map("compare_at_price")
  taxRate       Float    @default(0) @map("tax_rate")
  unit          String   @default("piece")
  purchaseUnit  String?  @map("purchase_unit")
  saleUnit      String?  @map("sale_unit")
  conversionFactor Float? @map("conversion_factor")
  minStock      Float    @default(0) @map("min_stock")
  currentStock  Float    @default(0) @map("current_stock")
  trackInventory Boolean @default(false) @map("track_inventory")
  isIngredient    Boolean  @default(false) @map("is_ingredient")
  techCard        String   @default("[]") @map("tech_card")
  preparationArea String?  @map("preparation_area")
  cookingMethod   String?  @map("cooking_method")
  noDiscounts     Boolean  @default(false) @map("no_discounts")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  tags          String   @default("[]")
  metadata      String   @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]
  inventory      InventoryMovement[]
  stockReceiptItems StockReceiptItem[]

  @@map("products")
}

model ProductModifierGroup {
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String         @map("product_id")
  modifierGroup   ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  modifierGroupId String         @map("modifier_group_id")

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

model ModifierGroup {
  id              String  @id @default(uuid())
  name            String
  description     String?
  isRequired      Boolean @default(false) @map("is_required")
  minSelections   Int     @default(0) @map("min_selections")
  maxSelections   Int     @default(1) @map("max_selections")
  sortOrder       Int     @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  products     ProductModifierGroup[]
  modifierItems ModifierItem[]

  @@map("modifier_groups")
}

model ModifierItem {
  id               String  @id @default(uuid())
  modifierGroupId  String  @map("modifier_group_id")
  modifierGroup    ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name             String
  price            Float   @default(0)
  costPrice        Float   @default(0) @map("cost_price")
  grossWeight      Float?  @map("gross_weight")
  imageUrl         String? @map("image_url")
  isActive         Boolean @default(true) @map("is_active")
  sortOrder        Int     @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  orderItemModifiers OrderItemModifier[]

  @@map("modifier_items")
}

model Table {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?  @map("branch_id")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number    String
  capacity  Int      @default(4)
  status    String   @default("available")
  zone      String?
  positionX Float?   @map("position_x")
  positionY Float?   @map("position_y")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders       Order[]
  reservations Reservation[]

  @@unique([tenantId, branchId, number])
  @@map("tables")
}

model Order {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String?   @map("branch_id")
  branch            Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId           String?   @map("table_id")
  table             Table?    @relation(fields: [tableId], references: [id])
  userId            String?   @map("user_id")
  user              User?     @relation(fields: [userId], references: [id])
  cashShiftId       String?   @map("cash_shift_id")
  cashShift         CashShift? @relation(fields: [cashShiftId], references: [id])
  orderNumber       Int       @default(0) @map("order_number")
  status            String    @default("pending")
  type              String    @default("dine_in")
  subtotal          Float     @default(0)
  taxAmount         Float     @default(0) @map("tax_amount")
  discountAmount    Float     @default(0) @map("discount_amount")
  total             Float     @default(0)
  notes             String?
  customerName      String?   @map("customer_name")
  customerPhone     String?   @map("customer_phone")
  estimatedReadyAt  DateTime? @map("estimated_ready_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  items     OrderItem[]
  payments  Payment[]
  receipts  Receipt[]

  @@index([tenantId])
  @@index([status])
  @@index([cashShiftId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      @default(1)
  weightGrams Float?   @map("weight_grams")
  unitPrice   Float    @map("unit_price")
  totalPrice  Float    @map("total_price")
  notes       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modifiers OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  id              String       @id @default(uuid())
  orderItemId     String       @map("order_item_id")
  orderItem       OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierItemId  String       @map("modifier_item_id")
  modifierItem    ModifierItem @relation(fields: [modifierItemId], references: [id])
  price           Float        @default(0)
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("order_item_modifiers")
}

model Payment {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId              String   @map("order_id")
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method               String
  amount               Float
  tipAmount            Float    @default(0) @map("tip_amount")
  status               String   @default("pending")
  transactionId        String?  @map("transaction_id")
  cardLastFour         String?  @map("card_last_four")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  metadata             String   @default("{}")
  processedAt          DateTime? @map("processed_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("payments")
}

model InventoryMovement {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  type       String
  quantity   Float
  reason     String?
  referenceId String? @map("reference_id")
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("inventory_movements")
}

model StockReceipt {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id])
  supplierName   String?  @map("supplier_name")
  invoiceNumber  String?  @map("invoice_number")
  totalAmount    Float    @default(0) @map("total_amount")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  items          StockReceiptItem[]

  @@map("stock_receipts")
}

model StockReceiptItem {
  id             String   @id @default(uuid())
  receiptId      String   @map("receipt_id")
  receipt        StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Float
  costPrice      Float    @map("cost_price")
  totalCost      Float    @map("total_cost")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("stock_receipt_items")
}

model Reservation {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId         String?  @map("branch_id")
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId          String?  @map("table_id")
  table            Table?   @relation(fields: [tableId], references: [id])
  customerName     String   @map("customer_name")
  customerPhone    String?  @map("customer_phone")
  customerEmail    String?  @map("customer_email")
  partySize        Int
  reservationDate  DateTime @map("reservation_date")
  reservationTime  DateTime @map("reservation_time")
  status           String   @default("confirmed")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("reservations")
}

model Receipt {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  template  String   @default("standard")
  content   String   @default("{}")
  printedAt DateTime? @map("printed_at")
  emailedAt DateTime? @map("emailed_at")
  emailTo   String?  @map("email_to")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("receipts")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model CashShift {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  status         String    @default("open")
  openingCash    Float     @default(0) @map("opening_cash")
  closingCash    Float?    @map("closing_cash")
  totalSales     Float     @default(0) @map("total_sales")
  totalCashSales Float     @default(0) @map("total_cash_sales")
  totalCardSales Float     @default(0) @map("total_card_sales")
  totalQrSales   Float     @default(0) @map("total_qr_sales")
  totalTips      Float     @default(0) @map("total_tips")
  totalRefunds   Float     @default(0) @map("total_refunds")
  expectedCash   Float?    @map("expected_cash")
  difference     Float?    @map("difference")
  notes          String?
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  orders Order[]

  @@map("cash_shifts")
}
