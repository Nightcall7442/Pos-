#!/bin/sh
# Файл СОРСИТСЯ энтрипоинтом nginx (*.envsh), поэтому обязан быть
# исполняемым — иначе энтрипоинт пишет "Ignoring ..., not executable" и
# директива resolver остаётся с неподставленным ${NGINX_LOCAL_RESOLVERS}.
#
# Образ должен экспортировать переменную сам (15-local-resolvers.envsh), но
# на Railway этого не произошло, поэтому считаем адрес из resolv.conf.
# IPv6-адреса nginx требует в квадратных скобках.
#
# Энтрипоинт работает с `set -e`: любая упавшая команда здесь убила бы
# запуск контейнера, поэтому всё прикрыто `|| true`.
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
    NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN { ORS=" " } $1 == "nameserver" { if (index($2, ":") > 0) print "["$2"]"; else print $2 }' /etc/resolv.conf 2>/dev/null || true)
    NGINX_LOCAL_RESOLVERS=$(echo "${NGINX_LOCAL_RESOLVERS}" | sed -e 's/[[:space:]]*$//' || true)
fi
[ -n "${NGINX_LOCAL_RESOLVERS}" ] || NGINX_LOCAL_RESOLVERS="1.1.1.1"
export NGINX_LOCAL_RESOLVERS
